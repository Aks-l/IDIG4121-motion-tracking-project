Intermediate/
Saved/
DerivedDataCache/
**/Plugins/*/Binaries/
**/Plugins/*/Intermediate/

# IDE project files (regenerate with "Generate Project Files")
*.xcworkspace/
*.xcodeproj/
*.sln
.vs/
.vscode/

# Local tooling
.mcp.json
*.uproject.bak
.DS_Store
